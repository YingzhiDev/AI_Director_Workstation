# Server-side model connection. Never commit a real key.
# If these three values are absent, local runs try LLM_API_FILE,
# ./LLM_API.txt, then ../LLM_API.txt and read the TokenPlan section.
LLM_MODEL_NAME=
LLM_FALLBACK_MODEL_NAMES=
LLM_API_KEY=
LLM_REQUEST_URL=

# Optional explicit local file path. The file must remain untracked.
# LLM_API_FILE=/absolute/path/to/LLM_API.txt

# Public showcase controls
DIRECTOR_WORKSPACE_DEMO_MODE=false
DIRECTOR_WORKSPACE_ALLOW_CUSTOM_API=false
DIRECTOR_WORKSPACE_ENABLE_UPLOADS=true
DIRECTOR_WORKSPACE_RATE_LIMIT_ENABLED=true
DIRECTOR_WORKSPACE_RATE_LIMIT_MAX_PER_HOUR=60
